# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=123456789:replace-with-your-token

# Optional: debug, info, warn, or error. Default: info.
LOG_LEVEL=info

# SQLite database containing full requests and bot responses.
# This file contains personal data; keep it private and backed up securely.
DATABASE_PATH=./data/bot.db

# Records older than this number of days are deleted automatically.
RETENTION_DAYS=30
